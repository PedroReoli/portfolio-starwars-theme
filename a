/* Aplicando o fundo preto e texto branco - Base responsiva */
.black-sky {
  background-color: black;
  color: white;
  min-height: 100vh;
  overflow-x: hidden;
  position: relative;
}

/* Estrelas - Versão responsiva otimizada */
.stars {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: transparent;
